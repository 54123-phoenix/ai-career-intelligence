# =============================================================================
# AI Career Intelligence — Environment Configuration
# =============================================================================

# ── Embedding: 阿里云 DashScope (通义千问) ──
# Primary embedding provider per project constraint. Pre-computed vectors stored
# in Qdrant use this provider. Local sentence-transformers serves as fallback.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# ── LLM: 阿里云 DashScope (通义千问) ──
# Primary LLM provider for all agent reasoning and chat.
LLM_API_KEY=${DASHSCOPE_API_KEY}
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── Qdrant ──
# Local mode (default): leave QDRANT_URL empty → in-memory
# Remote mode: uncomment and set URL + optional API key
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── CORS ──
FRONTEND_URL=http://localhost:3000

# ── Environment ──
ENV=development
